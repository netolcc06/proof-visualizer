unsat
(
(assume a0 (! (= a b) :named @p_1))
(assume a1 (! (not p) :named @p_2))
(assume a2 (! (or p (! (not (! (= (f a) (! (f b) :named @p_3)) :named @p_4)) :named @p_5)) :named @p_6))
(step t0 (cl (not (! (= @p_5 false) :named @p_7)) (not @p_5) false) :rule equiv_pos2)
(step t1 (cl @p_4) :rule cong :premises (a0))
(step t2 (cl (! (= @p_3 @p_3) :named @p_8)) :rule refl)
(step t3 (cl (= @p_4 @p_8)) :rule cong :premises (t1 t2))
(step t4 (cl (= @p_5 (! (not @p_8) :named @p_9))) :rule cong :premises (t3))
(step t5 (cl (= @p_8 true)) :rule hole :args ("untranslated rewrite"))
(step t6 (cl (= @p_9 (! (not true) :named @p_10))) :rule cong :premises (t5))
(step t7 (cl (= @p_10 false)) :rule hole :args ("untranslated rewrite"))
(step t8 (cl (= @p_9 false)) :rule trans :premises (t6 t7))
(step t9 (cl @p_7) :rule trans :premises (t4 t8))
(step t10 (cl p @p_5) :rule or :premises (a2))
(step t11 (cl @p_5) :rule resolution :premises (t10 a1))
(step t12 (cl false) :rule resolution :premises (t0 t9 t11))
(step t13 (cl (not false)) :rule false)
(step t14 (cl) :rule resolution :premises (t12 t13))
)
