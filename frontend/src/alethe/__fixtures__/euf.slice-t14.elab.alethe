(step t9 (cl (=> (and (= (f b) (f c)) (= a c)) (= (g (f a) b) (g (f b) b))) (not (= (g (f a) b) (g (f b) b)))) :rule implies_neg2)
(step t10 (cl (=> (and (= (f b) (f c)) (= a c)) (= (g (f a) b) (g (f b) b))) (=> (and (= (f b) (f c)) (= a c)) (= (g (f a) b) (g (f b) b)))) :rule resolution :premises (t8 t9) :args ((= (g (f a) b) (g (f b) b)) true))
