{
  "homepage": "https://ufmg-smite.github.io/proof-visualizer",
  "name": "proof-visualizer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "config": {
    "cvc5Version": "1.4.2"
  },
  "scripts": {
    "fetch:cvc5": "node scripts/fetch-cvc5.mjs",
    "fetch:verit": "node scripts/fetch-verit.mjs",
    "fetch:carcara": "node scripts/fetch-carcara.mjs",
    "predev": "npm run fetch:cvc5 && npm run fetch:verit && npm run fetch:carcara",
    "dev": "vite",
    "start": "vite",
    "prebuild": "npm run fetch:cvc5 && npm run fetch:verit && npm run fetch:carcara",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.21.0",
    "@blueprintjs/icons": "^6.14.1",
    "@dagrejs/dagre": "^3.1.3",
    "@monaco-editor/react": "^4.7.0",
    "@reduxjs/toolkit": "^2.13.0",
    "konva": "^10.9.0",
    "monaco-editor": "^0.57.0",
    "normalize.css": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
